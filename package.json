{
	"name": "@nakanoaas/eslint-plugin-tagged-error",
	"version": "0.0.4",
	"description": "ESLint plugin to check for duplicate TaggedError tags across the project",
	"keywords": [
		"error-handling",
		"eslint",
		"eslintplugin",
		"tagged-error"
	],
	"homepage": "https://github.com/nakanoasaservice/eslint-plugin-tagged-error",
	"bugs": {
		"url": "https://github.com/nakanoasaservice/eslint-plugin-tagged-error/issues"
	},
	"license": "ISC",
	"author": "Nakano as a Service",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nakanoasaservice/eslint-plugin-tagged-error.git"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "vp pack",
		"check:fix": "vp check --fix",
		"check": "vp check",
		"test": "vp test run"
	},
	"devDependencies": {
		"@types/eslint": "^9.6.1",
		"@types/estree": "^1.0.5",
		"@types/node": "^22.10.2",
		"eslint": "^9.17.0",
		"jsr": "0.14.3",
		"typescript": "^5.9.3",
		"vite-plus": "catalog:"
	},
	"peerDependencies": {
		"eslint": ">=8.0.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "24.22.1"
		}
	},
	"packageManager": "pnpm@12.21.0"
}
